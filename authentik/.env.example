# Copy to .env and fill in random values:
#   openssl rand -base64 36  -> PG_PASS
#   openssl rand -base64 60  -> AUTHENTIK_SECRET_KEY
PG_PASS=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# SocialLogins-authentik sample (used by blueprints/sociallogins.yaml)
#   openssl rand -hex 32 -> SOCIALLOGINS_CLIENT_SECRET
SOCIALLOGINS_CLIENT_SECRET=
DEMO_USER_PASSWORD=
